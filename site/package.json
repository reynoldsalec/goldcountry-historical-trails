{
  "name": "auburn-edition-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Static Auburn historical map edition browser (D3a shell; not release-ready)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:built": "playwright test --config playwright.built.config.ts",
    "browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "maplibre-gl": "6.11.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
