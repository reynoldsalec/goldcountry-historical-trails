# Immutable downloads and intermediates (AGENTS.md §2.2). Contents are never
# committed, but the directories themselves are kept so the layout in README §5
# exists on a fresh clone.
data/raw/*
!data/raw/.gitkeep
data/working/*
!data/working/.gitkeep
data/sources/.retrievals.lock

# Derived output (README §5).
build/*
!build/.gitkeep
site/dist/
# Generated browser-test fixtures and Playwright output (issue #44).
site/.playwright-fixtures/
site/.playwright-built/
site/test-results/
site/playwright-report/

# Environments
.venv/
node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store
