{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage_grid.schema.json",
  "title": "Coverage grid",
  "description": "The area units the coverage inventory is keyed on (data/sources/coverage_grid.geojson, built in a later M1 issue). Geometry is EPSG:4326 with coordinates truncated to six decimals (AGENTS.md §3); the truncation and the tiling itself are checked by the builder, not here. A cell is a research unit, never evidence of a trail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": { "const": "Feature" },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area_id", "county_geoids"],
          "properties": {
            "area_id": {
              "description": "Grid cell key: q7p5-<row>-<col>. Referenced by coverage.json.",
              "type": "string",
              "pattern": "^q7p5-[0-9]+-[0-9]+$"
            },
            "county_geoids": {
              "description": "Every county the cell touches. Nevada is 06057, Placer 06061.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["06057", "06061"] }
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    { "type": "number", "minimum": -180, "maximum": 180 },
                    { "type": "number", "minimum": -90, "maximum": 90 }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
