{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auburn map-browser edition manifest",
  "description": "Display metadata and verified crop footprint for the four selected Auburn editions. Dates describe the source sheet, never the age of an individual mapped feature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "area_id",
    "edition_order",
    "view_bounds_wgs84",
    "tile_zoom",
    "editions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "area_id": {
      "const": "auburn"
    },
    "edition_order": {
      "const": ["auburn-1953", "auburn-1973", "auburn-1975", "auburn-1981"]
    },
    "view_bounds_wgs84": {
      "description": "[west, south, east, north] of the common mapped footprint, after datum transformation to WGS84.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "tile_zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "const": 10 },
        "max": { "const": 16 }
      }
    },
    "editions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/edition" }
    }
  },
  "$defs": {
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "photography_date": {
      "description": "YYYY or YYYY-MM-DD. Calendar validity is enforced by scripts/demo.py.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$"
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "kind",
        "label",
        "citation",
        "source_url",
        "rights",
        "attribution",
        "dates",
        "date_note",
        "crop_wgs84"
      ],
      "properties": {
        "id": {
          "enum": ["auburn-1953", "auburn-1973", "auburn-1975", "auburn-1981"]
        },
        "source_id": {
          "enum": [
            "CA_Auburn_288101_1953_24000",
            "CA_Auburn_288103_1953_24000",
            "CA_Auburn_288104_1975_24000",
            "CA_Auburn_288105_1953_24000"
          ]
        },
        "kind": {
          "enum": ["topo", "orthophotoquad"]
        },
        "label": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "rights": { "const": "public_domain" },
        "attribution": { "type": "string", "minLength": 1 },
        "date_note": { "type": "string", "minLength": 1 },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "map_year",
            "base_year",
            "revision_year",
            "base_photography",
            "revision_photography",
            "photography",
            "base_field_check_year",
            "revision_field_checked"
          ],
          "properties": {
            "map_year": { "$ref": "#/$defs/year" },
            "base_year": {
              "oneOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }]
            },
            "revision_year": {
              "oneOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }]
            },
            "base_photography": { "$ref": "#/$defs/photography_date" },
            "revision_photography": { "$ref": "#/$defs/photography_date" },
            "photography": { "$ref": "#/$defs/photography_date" },
            "base_field_check_year": {
              "oneOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }]
            },
            "revision_field_checked": { "type": ["boolean", "null"] }
          }
        },
        "crop_wgs84": {
          "description": "Closed single-ring Polygon on the inspected source neatline; excludes the decorative scan margin only.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
